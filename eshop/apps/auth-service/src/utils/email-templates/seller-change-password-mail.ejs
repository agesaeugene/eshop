<!doctype html>
<html lang="en">
  <body style="font-family: Arial, sans-serif; color: #1f2937; line-height: 1.6;">
    <h2>Password change verification</h2>
    <p>Hello <%= name %>,</p>
    <p>Use this verification code to confirm your seller account password change:</p>
    <p style="font-size: 24px; font-weight: bold; letter-spacing: 6px;"><%= otp %></p>
    <p>This code expires in five minutes. If you did not request this change, you can ignore this email.</p>
  </body>
</html>
